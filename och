#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
och, small OpenClaw session helper

Usage:
  och session list [--agent <agent>]
  och session delete <session-key>
  och session name <session-key> [name]
  och session name --all [--agent <agent>]
  och workspace status [--agent <agent>]
  och tui <session-key> [openclaw-tui-args...]
  och skill list [agent]
  och skill open <skill-name>
  och skill print <skill-name>
  och memory list <agent>
  och memory open <agent> [--note <note>]
  och memory print <agent> [--note <note>]
  och agentsmd open|print <agent>
  och heartbeat open|print <agent>
  och identity open|print <agent>
  och soul open|print <agent>
  och tools open|print <agent>
  och usermd open|print <agent>
  och file open|print <agent> <relative-path>
  och help

Commands:
  session               List, delete, and name OpenClaw sessions
  workspace             Show Git status for agent workspaces
  tui                   Run openclaw tui for one session
  skill                 List, open, or print skills
  memory                List, open, or print MEMORY.md and daily memory notes
  agentsmd              Open or print AGENTS.md
  heartbeat             Open or print HEARTBEAT.md
  identity              Open or print IDENTITY.md
  soul                  Open or print SOUL.md
  tools                 Open or print TOOLS.md
  usermd                Open or print USER.md
  file                  Open or print any safe relative agent workspace path

Notes:
  - Session files live under ~/.openclaw/agents/<agent>/sessions/sessions.json
  - General skills live under ~/.openclaw/skills/
  - Agent skills live under ~/.openclaw/workspace/<agent>/skills/
  - Agent workspaces live under ~/.openclaw/workspace/<agent>/
  - print uses glow, then bat, then less/cat fallback
  - In-place JSON updates use jq + sponge
EOF
}

die() {
  printf 'och: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

open_file() {
  [[ $# -eq 1 ]] || die "usage: open_file <path>"
  [[ -n "${EDITOR:-}" ]] || die 'EDITOR is not set'
  "$EDITOR" "$1"
}

print_file() {
  [[ $# -eq 1 ]] || die "usage: print_file <path>"
  local file="$1"
  [[ -f "$file" ]] || die "file not found: $file"
  if command -v glow >/dev/null 2>&1; then
    glow "$file"
  elif command -v bat >/dev/null 2>&1; then
    bat --style=plain --paging=never "$file"
  elif [[ -t 1 ]]; then
    less -R "$file"
  else
    cat "$file"
  fi
}

setup_colors() {
  if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
    C_RESET=$'\033[0m'
    C_HEADER=$'\033[1;36m'
    C_LABEL=$'\033[1;34m'
    C_ITEM=$'\033[0;32m'
    C_VALUE=$'\033[0;33m'
    C_DIM=$'\033[2m'
  else
    C_RESET=''
    C_HEADER=''
    C_LABEL=''
    C_ITEM=''
    C_VALUE=''
    C_DIM=''
  fi
}

print_section_header() {
  local label="$1"
  local name="$2"
  local count="$3"
  local noun="$4"
  local suffix='s'
  [[ "$count" -eq 1 ]] && suffix=''
  printf '%s== %s%s %s%s (%s %s%s) ==%s\n' \
    "$C_HEADER" "$C_LABEL" "$label" "$name" "$C_HEADER" "$count" "$noun" "$suffix" "$C_RESET"
}

session_file_for_agent() {
  local agent="$1"
  printf '%s/.openclaw/agents/%s/sessions/sessions.json\n' "$HOME" "$agent"
}

require_session_file() {
  local file="$1"
  [[ -f "$file" ]] || die "session file not found: $file"
}

parse_optional_agent() {
  case $# in
    0)
      printf '\n'
      ;;
    1)
      case "$1" in
        -*)
          die "unknown argument: $1"
          ;;
        *)
          printf '%s\n' "$1"
          ;;
      esac
      ;;
    *)
      die "too many arguments"
      ;;
  esac
}

all_session_files() {
  local base_dir="$HOME/.openclaw/agents"
  local files=()
  mapfile -t files < <(find_session_files)
  ((${#files[@]} > 0)) || die "no session files found under: $base_dir"
  printf '%s\n' "${files[@]}"
}

find_session_files() {
  local base_dir="$HOME/.openclaw/agents"
  local files=()
  shopt -s nullglob
  files=("$base_dir"/*/sessions/sessions.json)
  shopt -u nullglob
  printf '%s\n' "${files[@]}"
}

session_files_for_scope() {
  local agent="$1"
  local file
  if [[ -n "$agent" ]]; then
    file="$(session_file_for_agent "$agent")"
    require_session_file "$file"
    printf '%s\n' "$file"
  else
    all_session_files
  fi
}

all_session_entries() {
  local file session_key display_name
  while IFS= read -r file; do
    while IFS=$'\t' read -r session_key display_name; do
      printf '%s\t%s\t%s\n' "$session_key" "$display_name" "$file"
    done < <(jq -r 'to_entries[] | [.key, (if .value.displayName == null then "" else .value.displayName end)] | @tsv' "$file")
  done < <(find_session_files)
}

all_agent_skill_dirs() {
  local base_dir="$HOME/.openclaw/workspace"
  local dirs=()
  shopt -s nullglob
  dirs=("$base_dir"/*/skills)
  shopt -u nullglob
  printf '%s\n' "${dirs[@]}"
}

skill_dirs_for_scope() {
  local agent="$1"
  local general_dir="$HOME/.openclaw/skills"
  local dir found=0

  if [[ -n "$agent" ]]; then
    dir="$HOME/.openclaw/workspace/$agent/skills"
    [[ -d "$dir" ]] || die "skills directory not found: $dir"
    if [[ -d "$general_dir" ]]; then
      printf '%s\n' "$general_dir"
      found=1
    fi
    printf '%s\n' "$dir"
    found=1
  else
    if [[ -d "$general_dir" ]]; then
      printf '%s\n' "$general_dir"
      found=1
    fi
    while IFS= read -r dir; do
      [[ -n "$dir" ]] || continue
      printf '%s\n' "$dir"
      found=1
    done < <(all_agent_skill_dirs)
  fi

  ((found)) || die "no skills directories found under: $HOME/.openclaw"
}

agent_from_session_key() {
  local session_key="$1"
  [[ "$session_key" == agent:*:* ]] || die "could not infer agent from session key: $session_key"
  local rest="${session_key#agent:}"
  printf '%s\n' "${rest%%:*}"
}

try_resolve_session_identifier() {
  local identifier="$1"
  local session_key display_name file
  local exact_key_matches=()
  local display_name_matches=()

  while IFS=$'\t' read -r session_key display_name file; do
    if [[ "$session_key" == "$identifier" ]]; then
      exact_key_matches+=("$session_key")
      continue
    fi
    if [[ -n "$display_name" && "$display_name" == "$identifier" ]]; then
      display_name_matches+=("$session_key")
    fi
  done < <(all_session_entries)

  if ((${#exact_key_matches[@]} == 1)); then
    printf '%s\n' "${exact_key_matches[0]}"
    return
  fi

  if ((${#display_name_matches[@]} == 1)); then
    printf '%s\n' "${display_name_matches[0]}"
    return
  fi

  if ((${#display_name_matches[@]} > 1)); then
    printf 'och: session name is ambiguous: %s\n' "$identifier" >&2
    printf 'och: matching session keys:\n' >&2
    printf '  %s\n' "${display_name_matches[@]}" >&2
    return 2
  fi

  return 1
}

resolve_session_identifier() {
  require_cmd jq
  local identifier="$1"
  local session_key status

  if session_key="$(try_resolve_session_identifier "$identifier")"; then
    printf '%s\n' "$session_key"
    return
  fi

  status=$?
  [[ "$status" -eq 2 ]] && exit 1
  die "session not found: $identifier"
}

confirm_create_session() {
  local session_key="$1"
  local reply

  [[ -t 0 ]] || die "session not found: $session_key (confirmation requires an interactive terminal)"

  printf 'och: session not found: %s\n' "$session_key" >&2
  printf 'och: this action will create a new session, continue? [y/N] ' >&2
  IFS= read -r reply || die "aborted"

  case "$reply" in
    y|Y|yes|YES|Yes)
      ;;
    *)
      die "aborted"
      ;;
  esac
}

resolve_launch_session_identifier() {
  require_cmd jq
  local identifier="$1"
  local session_key status

  if session_key="$(try_resolve_session_identifier "$identifier")"; then
    printf '%s\n' "$session_key"
    return
  fi

  status=$?
  [[ "$status" -eq 2 ]] && exit 1
  [[ "$identifier" == agent:*:* ]] || die "session not found: $identifier"

  confirm_create_session "$identifier"
  printf '%s\n' "$identifier"
}

cmd_list_sessions() {
  require_cmd jq
  local agent file agent_name first=1 count
  setup_colors
  agent="$(parse_optional_agent "$@")"
  while IFS= read -r file; do
    agent_name="$(basename "$(dirname "$(dirname "$file")")")"
    count="$(jq 'keys | length' "$file")"
    if [[ $first -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    print_section_header "agent" "$agent_name" "$count" "session"
    printf '%s%s%s\n' "$C_DIM" "$file" "$C_RESET"
    if [[ "$count" -eq 0 ]]; then
      printf '  %s(none)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    jq -r 'keys[]' "$file" | while IFS= read -r session_key; do
      printf '  %s- %s%s\n' "$C_ITEM" "$session_key" "$C_RESET"
    done
  done < <(session_files_for_scope "$agent")
}

cmd_get_session_names() {
  require_cmd jq
  local agent file agent_name first=1 count line session_key display_name
  setup_colors
  agent="$(parse_optional_agent "$@")"
  while IFS= read -r file; do
    agent_name="$(basename "$(dirname "$(dirname "$file")")")"
    count="$(jq 'keys | length' "$file")"
    if [[ $first -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    print_section_header "agent" "$agent_name" "$count" "session"
    printf '%s%s%s\n' "$C_DIM" "$file" "$C_RESET"
    if [[ "$count" -eq 0 ]]; then
      printf '  %s(none)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    while IFS=$'\t' read -r session_key display_name; do
      if [[ "$display_name" == "null" ]]; then
        printf '  %s- %s%s -> %snull%s\n' "$C_ITEM" "$session_key" "$C_RESET" "$C_DIM" "$C_RESET"
      else
        printf '  %s- %s%s -> %s%s%s\n' "$C_ITEM" "$session_key" "$C_RESET" "$C_VALUE" "$display_name" "$C_RESET"
      fi
    done < <(jq -r 'to_entries[] | [.key, (if .value.displayName == null then "null" else .value.displayName end)] | @tsv' "$file")
  done < <(session_files_for_scope "$agent")
}

cmd_name_session() {
  require_cmd jq
  require_cmd sponge
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: och session name <session-key> [name]"
  local session_identifier="$1"
  local session_key
  local agent file
  session_key="$(resolve_session_identifier "$session_identifier")"
  local name="${2:-$session_key}"
  agent="$(agent_from_session_key "$session_key")"
  file="$(session_file_for_agent "$agent")"
  require_session_file "$file"
  jq -e --arg key "$session_key" 'has($key)' "$file" >/dev/null || die "session not found: $session_key"
  jq --arg key "$session_key" --arg name "$name" '.[$key].displayName = $name' "$file" | sponge "$file"
}

cmd_name_sessions() {
  require_cmd jq
  require_cmd sponge
  local agent file
  agent="$(parse_optional_agent "$@")"
  while IFS= read -r file; do
    jq 'with_entries(.key as $k | .value |= . + { displayName: $k })' "$file" | sponge "$file"
  done < <(session_files_for_scope "$agent")
}

parse_agent_option() {
  local usage="$1"
  shift
  local agent=""
  while (($# > 0)); do
    case "$1" in
      --agent)
        shift
        [[ $# -gt 0 && -n "$1" ]] || die "$usage"
        agent="$1"
        ;;
      --agent=*)
        agent="${1#--agent=}"
        [[ -n "$agent" ]] || die "$usage"
        ;;
      *)
        die "$usage"
        ;;
    esac
    shift
  done
  printf '%s\n' "$agent"
}

cmd_session_list() {
  require_cmd jq
  local agent file agent_name first=1 count session_key display_name
  setup_colors
  agent="$(parse_agent_option "usage: och session list [--agent <agent>]" "$@")"
  while IFS= read -r file; do
    agent_name="$(basename "$(dirname "$(dirname "$file")")")"
    count="$(jq 'keys | length' "$file")"
    if [[ $first -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    print_section_header "agent" "$agent_name" "$count" "session"
    printf '%s%s%s\n' "$C_DIM" "$file" "$C_RESET"
    if [[ "$count" -eq 0 ]]; then
      printf '  %s(none)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    while IFS=$'\t' read -r session_key display_name; do
      if [[ -z "$display_name" || "$display_name" == "null" ]]; then
        printf '  %s- %s%s\n' "$C_ITEM" "$session_key" "$C_RESET"
      else
        printf '  %s- %s%s -> %s%s%s\n' "$C_ITEM" "$session_key" "$C_RESET" "$C_VALUE" "$display_name" "$C_RESET"
      fi
    done < <(jq -r 'to_entries[] | [.key, (if .value.displayName == null then "" else .value.displayName end)] | @tsv' "$file")
  done < <(session_files_for_scope "$agent")
}

cmd_session_name() {
  local all=0 agent="" args=()
  while (($# > 0)); do
    case "$1" in
      --all)
        all=1
        ;;
      --agent)
        shift
        [[ $# -gt 0 && -n "$1" ]] || die "usage: och session name (--all [--agent <agent>] | <session-key> [name])"
        agent="$1"
        ;;
      --agent=*)
        agent="${1#--agent=}"
        [[ -n "$agent" ]] || die "usage: och session name (--all [--agent <agent>] | <session-key> [name])"
        ;;
      --*)
        die "usage: och session name (--all [--agent <agent>] | <session-key> [name])"
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift
  done

  if ((all)); then
    ((${#args[@]} == 0)) || die "usage: och session name --all [--agent <agent>]"
    if [[ -n "$agent" ]]; then
      cmd_name_sessions "$agent"
    else
      cmd_name_sessions
    fi
    return
  fi

  [[ -z "$agent" ]] || die "--agent is only valid with --all"
  ((${#args[@]} >= 1 && ${#args[@]} <= 2)) || die "usage: och session name <session-key> [name]"
  cmd_name_session "${args[@]}"
}

cmd_session() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "usage: och session <list|delete|name> ..."
  shift
  case "$sub" in
    list)
      cmd_session_list "$@"
      ;;
    delete)
      cmd_delete_session "$@"
      ;;
    name)
      cmd_session_name "$@"
      ;;
    help|-h|--help)
      cat <<'EOF'
Usage:
  och session list [--agent <agent>]
  och session delete <session-key>
  och session name <session-key> [name]
  och session name --all [--agent <agent>]
EOF
      ;;
    *)
      die "unknown session command: $sub"
      ;;
  esac
}

find_workspace_dirs() {
  local base_dir="$HOME/.openclaw/workspace"
  local dirs=()
  shopt -s nullglob
  dirs=("$base_dir"/*)
  shopt -u nullglob
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] && printf '%s\n' "$dir"
  done
}

all_workspace_dirs() {
  local base_dir="$HOME/.openclaw/workspace"
  local dirs=()
  mapfile -t dirs < <(find_workspace_dirs)
  ((${#dirs[@]} > 0)) || die "no workspace directories found under: $base_dir"
  printf '%s\n' "${dirs[@]}"
}

workspace_dirs_for_scope() {
  local agent="$1"
  if [[ -n "$agent" ]]; then
    agent_workspace_dir "$agent"
  else
    all_workspace_dirs
  fi
}

cmd_workspace_status() {
  require_cmd git
  local agent dir agent_name first=1 found=0 status line
  setup_colors
  agent="$(parse_agent_option "usage: och workspace status [--agent <agent>]" "$@")"
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      continue
    fi
    found=1
    agent_name="$(basename "$dir")"
    if [[ $first -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    printf '%s== %sagent%s %s%s ==%s\n' "$C_HEADER" "$C_LABEL" "$C_HEADER" "$agent_name" "$C_HEADER" "$C_RESET"
    printf '%s%s%s\n' "$C_DIM" "$dir" "$C_RESET"
    if ! status="$(git -C "$dir" status --short --branch)"; then
      printf '  %s(git status failed)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    if [[ -z "$status" ]]; then
      printf '  %s(clean)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    while IFS= read -r line; do
      printf '  %s\n' "$line"
    done <<< "$status"
  done < <(workspace_dirs_for_scope "$agent")
  ((found)) || die "no git workspaces found under: $HOME/.openclaw/workspace"
}

cmd_workspace() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "usage: och workspace <status> ..."
  shift
  case "$sub" in
    status)
      cmd_workspace_status "$@"
      ;;
    help|-h|--help)
      cat <<'EOF'
Usage:
  och workspace status [--agent <agent>]
EOF
      ;;
    *)
      die "unknown workspace command: $sub"
      ;;
  esac
}

cmd_list_skills() {
  local agent dir skill scope_name scope_label first=1 count
  setup_colors
  agent="$(parse_optional_agent "$@")"
  while IFS= read -r dir; do
    if [[ "$dir" == "$HOME/.openclaw/skills" ]]; then
      scope_label="scope"
      scope_name="general"
    else
      scope_label="agent"
      scope_name="$(basename "$(dirname "$dir")")"
    fi
    shopt -s nullglob
    local skills=("$dir"/*)
    shopt -u nullglob
    count="${#skills[@]}"
    if [[ $first -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    print_section_header "$scope_label" "$scope_name" "$count" "skill"
    printf '%s%s%s\n' "$C_DIM" "$dir" "$C_RESET"
    if ((${#skills[@]} == 0)); then
      printf '  %s(none)%s\n' "$C_DIM" "$C_RESET"
      continue
    fi
    for skill in "${skills[@]}"; do
      printf '  %s- %s%s\n' "$C_ITEM" "$(basename "$skill")" "$C_RESET"
    done
  done < <(skill_dirs_for_scope "$agent")
}

resolve_skill_file() {
  [[ $# -eq 1 ]] || die "usage: resolve_skill_file <skill-name>"
  local skill_name="$1"
  local general_dir="$HOME/.openclaw/skills"
  local workspace_dir="$HOME/.openclaw/workspace"
  local general_skill_file="$general_dir/$skill_name/SKILL.md"
  local matches=()
  local match
  if [[ -f "$general_skill_file" ]]; then
    matches+=("$general_skill_file")
  fi
  shopt -s nullglob
  for match in "$workspace_dir"/*/skills/"$skill_name"/SKILL.md; do
    matches+=("$match")
  done
  shopt -u nullglob
  case "${#matches[@]}" in
    0)
      die "skill not found: $skill_name"
      ;;
    1)
      printf '%s\n' "${matches[0]}"
      ;;
    *)
      printf 'och: several skills match %s\n' "$skill_name" >&2
      printf '%s\n' "${matches[@]}"
      return 1
      ;;
  esac
}

cmd_skill_open() {
  [[ $# -eq 1 ]] || die "usage: och skill open <skill-name>"
  local file
  file="$(resolve_skill_file "$1")"
  open_file "$file"
}

cmd_skill_print() {
  [[ $# -eq 1 ]] || die "usage: och skill print <skill-name>"
  local file
  file="$(resolve_skill_file "$1")"
  print_file "$file"
}

cmd_skill() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "usage: och skill <list|open|print> ..."
  shift
  case "$sub" in
    list)
      cmd_list_skills "$@"
      ;;
    open)
      cmd_skill_open "$@"
      ;;
    print)
      cmd_skill_print "$@"
      ;;
    help|-h|--help)
      cat <<'EOF'
Usage:
  och skill list [agent]
  och skill open <skill-name>
  och skill print <skill-name>
EOF
      ;;
    *)
      die "unknown skill command: $sub"
      ;;
  esac
}

agent_workspace_dir() {
  local agent="$1"
  local dir="$HOME/.openclaw/workspace/$agent"
  [[ -d "$dir" ]] || die "agent workspace not found: $dir"
  printf '%s\n' "$dir"
}

agent_workspace_file() {
  [[ $# -eq 2 ]] || die "usage: agent_workspace_file <agent> <relative-path>"
  local agent="$1"
  local rel_path="$2"
  case "$rel_path" in
    ""|/*|*../*|../*|*/..|..)
      die "file path must be relative and stay inside the agent workspace"
      ;;
  esac
  local workspace target parent
  workspace="$(agent_workspace_dir "$agent")"
  target="$workspace/$rel_path"
  parent="$(dirname "$target")"
  [[ -d "$parent" ]] || die "parent directory not found: $parent"
  printf '%s\n' "$target"
}

cmd_file_open() {
  [[ $# -eq 2 ]] || die "usage: och file open <agent> <relative-path>"
  local file
  file="$(agent_workspace_file "$1" "$2")"
  open_file "$file"
}

cmd_file_print() {
  [[ $# -eq 2 ]] || die "usage: och file print <agent> <relative-path>"
  local file
  file="$(agent_workspace_file "$1" "$2")"
  print_file "$file"
}

cmd_file() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "usage: och file <open|print> <agent> <relative-path>"
  shift
  case "$sub" in
    open)
      cmd_file_open "$@"
      ;;
    print)
      cmd_file_print "$@"
      ;;
    help|-h|--help)
      cat <<'EOF'
Usage:
  och file open <agent> <relative-path>
  och file print <agent> <relative-path>
EOF
      ;;
    *)
      die "unknown file command: $sub"
      ;;
  esac
}

cmd_workspace_file() {
  local rel_path="$1"
  local noun="$2"
  local sub="${3:-}"
  [[ -n "$sub" ]] || die "usage: och $noun <open|print> <agent>"
  shift 3
  case "$sub" in
    open)
      [[ $# -eq 1 ]] || die "usage: och $noun open <agent>"
      local file
      file="$(agent_workspace_file "$1" "$rel_path")"
      open_file "$file"
      ;;
    print)
      [[ $# -eq 1 ]] || die "usage: och $noun print <agent>"
      local file
      file="$(agent_workspace_file "$1" "$rel_path")"
      print_file "$file"
      ;;
    help|-h|--help)
      printf 'Usage:\n  och %s open <agent>\n  och %s print <agent>\n' "$noun" "$noun"
      ;;
    *)
      die "unknown $noun command: $sub"
      ;;
  esac
}

memory_dir_for_agent() {
  local agent="$1"
  local dir
  dir="$(agent_workspace_dir "$agent")/memory"
  [[ -d "$dir" ]] || die "memory directory not found: $dir"
  printf '%s\n' "$dir"
}

cmd_memory_list() {
  [[ $# -eq 1 ]] || die "usage: och memory list <agent>"
  local dir file count=0
  dir="$(memory_dir_for_agent "$1")"
  shopt -s nullglob
  local files=("$dir"/*.md)
  shopt -u nullglob
  printf '%s\n' "$dir"
  if ((${#files[@]} == 0)); then
    printf '  (none)\n'
    return
  fi
  for file in "${files[@]}"; do
    printf '  - %s\n' "$(basename "$file")"
    count=$((count + 1))
  done
}

resolve_memory_note_file() {
  [[ $# -eq 2 ]] || die "usage: resolve_memory_note_file <agent> <note>"
  local agent="$1"
  local note="$2"
  local dir candidate stem
  local matches=()
  [[ -n "$note" ]] || die "memory note cannot be empty"
  case "$note" in
    */*|..|*../*|../*|*/..)
      die "memory note must be a filename or date prefix, not a path"
      ;;
  esac
  dir="$(memory_dir_for_agent "$agent")"
  if [[ -f "$dir/$note" ]]; then
    printf '%s\n' "$dir/$note"
    return
  fi
  if [[ "$note" != *.md && -f "$dir/$note.md" ]]; then
    printf '%s\n' "$dir/$note.md"
    return
  fi
  stem="${note%.md}"
  shopt -s nullglob
  matches=("$dir"/"$stem"*.md)
  shopt -u nullglob
  case "${#matches[@]}" in
    0)
      die "memory note not found: $note"
      ;;
    1)
      printf '%s\n' "${matches[0]}"
      ;;
    *)
      printf 'och: memory note is ambiguous: %s\n' "$note" >&2
      printf 'och: matching notes:\n' >&2
      printf '  %s\n' "${matches[@]##*/}" >&2
      return 1
      ;;
  esac
}

memory_target_file() {
  local usage="$1"
  shift
  [[ $# -ge 1 ]] || die "$usage"
  local agent="$1"
  shift
  local note=""
  while (($# > 0)); do
    case "$1" in
      --note)
        shift
        [[ $# -gt 0 && -n "$1" ]] || die "$usage"
        note="$1"
        ;;
      --note=*)
        note="${1#--note=}"
        [[ -n "$note" ]] || die "$usage"
        ;;
      *)
        die "$usage"
        ;;
    esac
    shift
  done
  if [[ -n "$note" ]]; then
    resolve_memory_note_file "$agent" "$note"
  else
    agent_workspace_file "$agent" "MEMORY.md"
  fi
}

cmd_memory_open() {
  local file
  file="$(memory_target_file "usage: och memory open <agent> [--note <note>]" "$@")"
  open_file "$file"
}

cmd_memory_print() {
  local file
  file="$(memory_target_file "usage: och memory print <agent> [--note <note>]" "$@")"
  print_file "$file"
}

cmd_memory() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "usage: och memory <list|open|print> ..."
  shift
  case "$sub" in
    list)
      cmd_memory_list "$@"
      ;;
    open)
      cmd_memory_open "$@"
      ;;
    print)
      cmd_memory_print "$@"
      ;;
    help|-h|--help)
      cat <<'EOF'
Usage:
  och memory list <agent>
  och memory open <agent> [--note <note>]
  och memory print <agent> [--note <note>]

Notes:
  --note accepts a full filename, filename without .md, or unambiguous date prefix.
EOF
      ;;
    *)
      die "unknown memory command: $sub"
      ;;
  esac
}

cmd_delete_session() {
  require_cmd jq
  require_cmd sponge
  [[ $# -eq 1 ]] || die "usage: och session delete <session-key>"
  local session_identifier="$1"
  local session_key
  local agent file
  session_key="$(resolve_session_identifier "$session_identifier")"
  agent="$(agent_from_session_key "$session_key")"
  file="$(session_file_for_agent "$agent")"
  require_session_file "$file"
  jq -e --arg key "$session_key" 'has($key)' "$file" >/dev/null || die "session not found: $session_key"
  jq --arg key "$session_key" 'del(.[$key])' "$file" | sponge "$file"
}

cmd_launch_tui_session() {
  case "${1:-}" in
    -h|--help|"")
      cat <<'EOF'
Usage:
  och tui <session-key> [openclaw-tui-args...]
  och tui -h|--help

Wraps:
  openclaw tui --session <resolved-session-key> [openclaw-tui-args...]

If <session-key> is a missing agent:<agent>:<name> key, asks before launching it as
a new session.
EOF
      [[ $# -gt 0 ]] || return 1
      return 0
      ;;
  esac

  require_cmd openclaw

  local session_key
  session_key="$(resolve_launch_session_identifier "$1")"
  shift

  exec openclaw tui --session "$session_key" "$@"
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    session)
      shift
      cmd_session "$@"
      ;;
    workspace)
      shift
      cmd_workspace "$@"
      ;;
    tui)
      shift
      cmd_launch_tui_session "$@"
      ;;
    skill)
      shift
      cmd_skill "$@"
      ;;
    memory)
      shift
      cmd_memory "$@"
      ;;
    agentsmd)
      shift
      cmd_workspace_file "AGENTS.md" "agentsmd" "$@"
      ;;
    heartbeat)
      shift
      cmd_workspace_file "HEARTBEAT.md" "heartbeat" "$@"
      ;;
    identity)
      shift
      cmd_workspace_file "IDENTITY.md" "identity" "$@"
      ;;
    soul)
      shift
      cmd_workspace_file "SOUL.md" "soul" "$@"
      ;;
    tools)
      shift
      cmd_workspace_file "TOOLS.md" "tools" "$@"
      ;;
    usermd)
      shift
      cmd_workspace_file "USER.md" "usermd" "$@"
      ;;
    file)
      shift
      cmd_file "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
